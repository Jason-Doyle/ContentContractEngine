{
  "name": "content-contract-engine",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first validation and rendering engine for reliable content.",
  "author": "Jason Doyle",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "content-contract": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "docs",
    "src",
    "examples/basic/content-contract.config.json",
    "examples/basic/content",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:self": "node dist/bin.js verify --config content-contract.config.json",
    "verify:example": "node dist/bin.js verify --config examples/basic/content-contract.config.json",
    "render:example": "node dist/bin.js render --config examples/basic/content-contract.config.json",
    "smoke:bin": "node scripts/smoke-bin.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "qa": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run smoke:bin && npm run verify:self && npm run verify:example && npm run smoke:package && npm run smoke:install",
    "prepublishOnly": "npm run qa"
  },
  "keywords": [
    "content",
    "validation",
    "markdown",
    "documentation",
    "content-contracts",
    "static-sites"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jason-Doyle/ContentContractEngine.git"
  },
  "bugs": {
    "url": "https://github.com/Jason-Doyle/ContentContractEngine/issues"
  },
  "homepage": "https://github.com/Jason-Doyle/ContentContractEngine#readme",
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-glob": "^3.3.3",
    "github-slugger": "^2.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
