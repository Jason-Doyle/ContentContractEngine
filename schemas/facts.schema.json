{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Jason-Doyle/ContentContractEngine/main/schemas/facts.schema.json",
  "title": "Content Contract Engine facts",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "facts"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "facts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value"],
        "properties": {
          "value": {
            "type": ["string", "number", "integer", "boolean"]
          },
          "render": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "reviewBy": {
            "type": "string",
            "minLength": 1
          },
          "expires": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
