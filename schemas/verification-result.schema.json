{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Jason-Doyle/ContentContractEngine/main/schemas/verification-result.schema.json",
  "title": "Content Contract Engine verification result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "passed", "failOn", "counts", "findings"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "passed": {
      "type": "boolean"
    },
    "failOn": {
      "enum": ["error", "warning", "never"]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "facts", "errors", "warnings", "infos"],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "facts": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "infos": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "ruleName", "severity", "file", "message", "help"],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "ruleName": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "help": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
