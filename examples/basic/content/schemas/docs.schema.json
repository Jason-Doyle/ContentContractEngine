{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "reviewBy"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reviewBy": {
      "type": "string",
      "format": "date"
    },
    "expires": {
      "type": "string",
      "format": "date"
    }
  }
}
